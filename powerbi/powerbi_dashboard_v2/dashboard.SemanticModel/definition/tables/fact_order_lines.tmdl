	column 'Discounted Line' = fact_order_lines[unitprice] <> fact_order_lines[netprice]
		dataType: boolean
		lineageTag: d3bdf63c-57e6-44fa-9d48-ab368a1bc839
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Discount Depth %' = DIVIDE(fact_order_lines[unitprice] - fact_order_lines[netprice], fact_order_lines[unitprice]) * 100
		dataType: double
		formatString: 0.00
		lineageTag: 0661c8c2-f93b-4602-91d1-80b6ad92575d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Line Discount Dollars' = fact_order_lines[quantity] * (fact_order_lines[unitprice] - fact_order_lines[netprice])
		dataType: decimal
		formatString: \$#,0.00
		lineageTag: 8e642e58-b695-47ee-a51b-10a44909b986
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Discount Band' =
			
			SWITCH(
			    TRUE(),
			    NOT fact_order_lines[Discounted Line], "Full price",
			    fact_order_lines[Discount Depth %] < 5, "Under 5%",
			    fact_order_lines[Discount Depth %] < 10, "5 to 10%",
			    fact_order_lines[Discount Depth %] < 20, "10 to 20%",
			    "20% and above"
			)
		dataType: string
		lineageTag: a88840fb-6f20-48ed-b821-7f9248cbbdc7
		summarizeBy: none
		sortByColumn: 'Discount Band Order'

		annotation SummarizationSetBy = Automatic

	column 'Discount Band Order' =
			
			SWITCH(
			    TRUE(),
			    NOT fact_order_lines[Discounted Line], 0,
			    fact_order_lines[Discount Depth %] < 5, 1,
			    fact_order_lines[Discount Depth %] < 10, 2,
			    fact_order_lines[Discount Depth %] < 20, 3,
			    4
			)
		dataType: int64
		formatString: 0
		lineageTag: 4531b7b8-7230-4e19-a77f-c3e528d2c26c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Customer Line Count' = CALCULATE(COUNTROWS(fact_order_lines), ALLEXCEPT(fact_order_lines, fact_order_lines[customerkey]))
		dataType: int64
		formatString: 0
		lineageTag: e24d3494-cd69-4f91-a013-678fbb4649f6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Customer Discounted Lines' = CALCULATE(COUNTROWS(fact_order_lines), ALLEXCEPT(fact_order_lines, fact_order_lines[customerkey]), fact_order_lines[Discounted Line] = TRUE())
		dataType: int64
		formatString: 0
		lineageTag: bb3456f9-2a00-4219-895e-8bfb263fcea6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Customer Rate Band' = INT(DIVIDE(fact_order_lines[Customer Discounted Lines] * 10, fact_order_lines[Customer Line Count])) * 10
		dataType: int64
		formatString: 0
		lineageTag: 2e8c5c55-fffb-4e96-91b9-544b24f6a427
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Customer Rate Band Label' =
			
			SWITCH(
			    TRUE(),
			    fact_order_lines[Customer Rate Band] = 100, "100%",
			    fact_order_lines[Customer Rate Band] & "-" & (fact_order_lines[Customer Rate Band] + 10) & "%"
			)
		dataType: string
		lineageTag: b62c1dcb-211e-4a5f-8d86-055634c408e2
		summarizeBy: none
		sortByColumn: 'Customer Rate Band'

		annotation SummarizationSetBy = Automatic

	column 'Discount Amount' =
			
			([unitprice] - [netprice]) * [quantity]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 87afc825-d996-44e5-a4dc-d35698d2d228
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

