table _Measures_customers
	lineageTag: a15c18a9-af7e-4cc7-ba58-d518d51111e8

	measure 'Total Customers' = COUNTROWS(customer_segments)
		formatString: 0
		lineageTag: 2a49f6f7-b3bc-46c9-8388-ee52257e8c41

	measure 'Avg Customer Margin' = AVERAGE(customer_segments[avg_margin])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: db1fbce8-0ca6-461b-82d1-0e56a941894b

	measure 'Avg Order Lines' = AVERAGE(customer_segments[total_order_lines])
		formatString: 0.0
		lineageTag: 2bc8811e-6a48-44d3-b248-2a3f3917eb70

	measure 'Avg Customer Discount Usage' = AVERAGE(customer_segments[discount_pct]) / 100
		formatString: 0%;-0%;0%
		lineageTag: 383a5a50-1adb-402b-90b0-b0db1a078535

	measure 'Store Margin StdDev' =
			
			STDEVX.P(
			    VALUES(fact_order_lines[storekey]),
			    [Avg Margin %]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: cf286145-0211-47d3-9843-0c6bacc090d9

	partition _Measures_customers = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

