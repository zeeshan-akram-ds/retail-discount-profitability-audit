table _Measures
	lineageTag: 97a2d283-b1c5-4c64-96e2-d157e1441414

	measure 'Total Revenue' = SUM(fact_order_lines[Revenue])
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: a37419a6-02d6-4360-8807-094f9a6f0e25

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Profit' = SUM(fact_order_lines[Profit])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 032344e7-f571-4221-b3ee-e09219fb95e4

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Margin %' =
			
			AVERAGEX(
			    fact_order_lines,
			    DIVIDE(
			        fact_order_lines[Profit],
			        fact_order_lines[Revenue]
			    )
			)
		formatString: 0%;-0%;0%
		lineageTag: 1b19dd10-d406-43ba-8867-c123789b1d75

	measure 'Total Order Lines' = COUNTROWS(fact_order_lines)
		formatString: 0
		lineageTag: 2403b051-81c3-4d62-b7f0-d30215c01abf

	measure 'Discounted Lines' = CALCULATE([Total Order Lines], fact_order_lines[UnitPrice] > fact_order_lines[NetPrice])
		formatString: 0
		lineageTag: 2ede7e6d-e71c-4ce8-bc73-aaab2b6b347d

	measure 'Discount Penetration' = DIVIDE([Discounted Lines], [Total Order Lines], 0)
		formatString: 0%;-0%;0%
		lineageTag: c0373bb3-a9f1-40eb-bda9-7464281236b3

	measure 'Discounted Margin' = CALCULATE([Avg Margin %], fact_order_lines[UnitPrice] > fact_order_lines[NetPrice])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e24fdb6d-5800-4c8a-9751-0b5abb48690c

	measure 'Full Price Margin' = CALCULATE([Avg Margin %], fact_order_lines[UnitPrice] = fact_order_lines[NetPrice])
		lineageTag: 16250684-e1c5-4f2e-b366-9ef2d26f9fef

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Profit Per Discounted Line' = CALCULATE(DIVIDE([Total Profit], [Total Order Lines]), fact_order_lines[UnitPrice] > fact_order_lines[NetPrice])
		formatString: \$#,0.0000;(\$#,0.0000);\$#,0.0000
		lineageTag: 1395cb66-b60f-4d53-802a-abb6f7dcbf11

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Profit Per Full Price Line' = CALCULATE(DIVIDE([Total Profit], [Total Order Lines]), fact_order_lines[UnitPrice] = fact_order_lines[NetPrice])
		formatString: \$#,0.0000;(\$#,0.0000);\$#,0.0000
		lineageTag: 9997a14a-f67c-4ecf-a672-befeb6dfae88

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Profit Gap' =
			
			INT([Profit Per Full Price Line])
			-
			INT([Profit Per Discounted Line])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: e464fa23-6018-43ee-9bad-e15d16348b40

	measure Subtitle_Rev = FORMAT([Total Order Lines], "#,##0") & " order lines"
		lineageTag: d9961776-4f8a-4ff6-ba2f-0a926b9efbe9

	measure Subtitle_MarginBase = "Arithmetic mean per line"
		lineageTag: 472980c2-3a8b-4fec-b4a2-a2c256a1788e

	measure Subtitle_Penetration = "Transactions below list price"
		lineageTag: d8efda2e-15f5-43cc-9fa3-c0a0a9348c7a

	measure Subtitle_Impact = "vs " & FORMAT([Full Price Margin], "0.0%") & " full-price"
		lineageTag: 73acef9b-5310-4418-a2dc-87c4b2baf472

	measure Subtitle_Gap = "Per discounted line"
		lineageTag: 06410d61-c1ba-43a7-b1a3-d046e1388182

	measure 'Estimated Margin Leakage' =
			
			ABS(SUMX(
			    FILTER(fact_order_lines, fact_order_lines[is_discounted] = TRUE),
			    ([Full Price Margin] - fact_order_lines[margin_pct]) * fact_order_lines[revenue]
			))
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: e9120c5d-8c51-402f-a68f-92fbd941abc2

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Margin Drop' =
			
			[Full Price Margin] - [Avg Margin %]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b8d4290d-4fd1-45af-b02a-784dc0bcce7e

	measure 'Avg Line Discount' =
			
			AVERAGE(fact_order_lines[discount_pct]) / 100
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 21e8e87d-ea12-40a1-b653-8e4da7eba439

	measure 'High Discount Lines' =
			
			CALCULATE(
			    COUNTROWS(fact_order_lines),
			    fact_order_lines[discount_tier] = "High Discount (10-20%)"
			)
		formatString: #,0
		lineageTag: 3e953e10-5432-45a4-ae45-c4bcca85eebe

	measure 'High Discount Share' =
			
			DIVIDE(
			    [High Discount Lines],
			    [Total Order Lines],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9cb1e6a2-22b6-4af3-bdf3-e342a4c8d694

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

